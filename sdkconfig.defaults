CONFIG_IDF_TARGET="esp32s3"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# Console on USB Serial/JTAG: boot diagnostics + probe output. The data link
# (tx.c) writes to the same peripheral; capture.py tolerates stray lines.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
# INFO so probe/bench logs are visible; the production build can lower this.
# (STRAY console lines on the USB link are tolerated by tools/capture.py.)
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
# 16 MB flash on the Waveshare ESP32-S3-LCD-1.9 (W25Q128)
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# 8 MB octal PSRAM (ESP32-S3R8) — shadow framebuffer lives here
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
